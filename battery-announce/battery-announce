def cmd_run():
    """The background service: poll the battery forever, reloading config.json
    whenever it changes (after a calibration or mute, for example)."""
    cfg = load_config()
    # Stop cleanly when systemd (SIGTERM) or Ctrl+C (SIGINT) asks.
    stop = {"flag": False}
    signal.signal(signal.SIGTERM, lambda *_: stop.update(flag=True))
    signal.signal(signal.SIGINT, lambda *_: stop.update(flag=True))
    a = Announcer(cfg)
    log(f"started; battery={find_battery()} source={cfg['percent_source']} "
        f"scale={cfg['percent_scale']} offset={cfg['percent_offset']}")
    last_mtime = None
    while not stop["flag"]:
        try:
            # Reload settings if the config file's modification time changed.
            m = os.path.getmtime(CONFIG_PATH) if os.path.exists(CONFIG_PATH) else None
            if m != last_mtime:
                if last_mtime is not None:
                    old_cfg, a.cfg = a.cfg, load_config()
                    a.ph = a.cfg["phrases"]
                    a.settings_changed(old_cfg)
                    log("config reloaded")
                last_mtime = m
            st = read_state(a.cfg)
            if st:
                a.tick(st)
        except Exception as e:
            log(f"error: {e}")          # never let one bad reading kill the service
        # Sleep in short steps so a stop request is handled promptly.
        for _ in range(int(max(1, a.cfg["poll_seconds"]) * 4)):
            if stop["flag"]:
                break
            time.sleep(0.25)
    log("stopped")


