    return 1


def _alerts_tk():
    """The Battery Alerts window."""
    import tkinter as tk

    # Same look as the calibration window.
    BG, CARD, FG, DIM, ACC, OK, BAD = ("#15171c", "#22262e", "#eef1f6", "#9aa3b2",
                                       "#3d8bfd", "#2fb36d", "#e5534b")
    root = tk.Tk()
    root.title("Battery Alerts")
    root.configure(bg=BG)
    sw, sh = root.winfo_screenwidth(), root.winfo_screenheight()
    u = max(13, min(sh // 38, 36))            # base font size, scales with screen
    w, h = min(sw, u * 52), min(sh, u * 34)
    root.geometry(f"{w}x{h}+{(sw - w) // 2}+{(sh - h) // 2}")
    F = lambda m, bold=False: ("DejaVu Sans", int(u * m), "bold" if bold else "normal")

    # Dark styling for the level dropdowns (ttk.Combobox) and their pop-up lists.
    from tkinter import ttk
    style = ttk.Style(root)
    style.theme_use("clam")
    style.configure("Level.TCombobox", fieldbackground=CARD, background=CARD, foreground=ACC,
                    arrowcolor=FG, bordercolor=CARD, lightcolor=CARD, darkcolor=CARD,
                    selectbackground=CARD, selectforeground=ACC, arrowsize=int(u * 0.9),
                    padding=int(u * 0.15))
    style.map("Level.TCombobox", fieldbackground=[("readonly", CARD)],
              foreground=[("readonly", ACC)], background=[("active", ACC)])
    root.option_add("*TCombobox*Listbox.font", F(0.85, True))
    root.option_add("*TCombobox*Listbox.background", CARD)
    root.option_add("*TCombobox*Listbox.foreground", FG)
    root.option_add("*TCombobox*Listbox.selectBackground", ACC)
    root.option_add("*TCombobox*Listbox.selectForeground", "white")

    # The settings being edited. Lists hold tk variables so the widgets and
    # the data stay in step; `collect()` turns them back into a plain dict.
    model = alert_settings(load_config())
    defaults = default_alert_settings()
    state = {"page": None, "dirty": False}

    def mark_dirty(*_):
        """Note that something was edited (called by every field's trace)."""
        state["dirty"] = True
        status.config(text="Unsaved changes", fg=DIM)

    def btn(parent, text, cmd, color=CARD, fg=FG, size=0.9, width=3):
        """A flat button that highlights when it has keyboard focus."""
        return tk.Button(parent, text=text, command=cmd, font=F(size, True), bg=color, fg=fg,
                         activebackground=ACC, activeforeground="white", relief="flat",
                         bd=0, highlightthickness=2, highlightbackground=BG,
                         highlightcolor=ACC, width=width, cursor="hand2", takefocus=1,
                         padx=u * 0.2)

    def entry(parent, var):
        """A message text box; any edit marks the window as changed."""
        var.trace_add("write", mark_dirty)
        return tk.Entry(parent, textvariable=var, font=F(0.85), bg=CARD, fg=FG,
                        insertbackground=FG, relief="flat", highlightthickness=2,
                        highlightbackground=CARD, highlightcolor=ACC)

    def play(get_text, get_level):
        """Speak a message as it would sound (the ▶ buttons)."""
        _speak_async(_sample_text(get_text(), get_level()))

    def level_picker(parent, value, on_pick, allow_off=False):
        """A dropdown of levels 1%-99% (plus "Off" = 0 if allowed).

        Clicking anywhere on the box opens the list (an easy target with a VR
        pointer); it scrolls and shows 8 levels at a time (short enough to fit
        on screen above or below the box). `on_pick(level)` is
        called with the new level and returns False to refuse it (the old
        value is restored).
        """
        choices = (["Off"] if allow_off else []) + [f"{n}%" for n in range(1, 100)]
        label = lambda n: "Off" if n == 0 else f"{n}%"
        var = tk.StringVar(value=label(value))
        box = ttk.Combobox(parent, textvariable=var, values=choices, width=4, height=8,
                           font=F(1.05, True), style="Level.TCombobox", justify="center",
                           state="readonly")
        box.current_level = value

        def commit(_=None):
            """Check the chosen level and pass it on (or undo it)."""
            text = var.get().strip().rstrip("%").strip()
            try:
                n = 0 if allow_off and text.lower() in ("off", "0") else int(text)
            except ValueError:
                n = None
            if n is None or not (0 if allow_off else 1) <= n <= 99 or on_pick(n) is False:
                var.set(label(box.current_level))       # refused: put the old value back
                return
            box.current_level = n
            var.set(label(n))

        box.bind("<<ComboboxSelected>>", commit)
        return box

    # ---- layout: title, tabs, page area, bottom bar
    tk.Label(root, text="Battery Alerts", font=F(1.4, True), bg=BG, fg=FG).pack(pady=(u * 0.5, u * 0.3))
    tabs = tk.Frame(root, bg=BG)
    tabs.pack()
    page_area = tk.Frame(root, bg=BG)
    page_area.pack(fill="both", expand=True, padx=u, pady=(u * 0.4, 0))
    bottom = tk.Frame(root, bg=BG)
    bottom.pack(fill="x", padx=u, pady=u * 0.5)
    status = tk.Label(bottom, text="", font=F(0.75), bg=BG, fg=DIM, anchor="w", justify="left",
                      wraplength=w - u * 22)
    status.pack(side="left", fill="x", expand=True)

    # ---- level list page (shared by "On battery" and "Charging")
    lists = {"battery": [], "charging": []}   # rows: {"level": IntVar, "message": StringVar}

    def make_list_page(name, intro, shared_default, new_level):
        """Build an editable list of levels ("battery" or "charging"): intro
        text, a scrollable row per level, and an "Add level" button.
        `new_level(taken)` picks the level for a newly added row."""
        page = tk.Frame(page_area, bg=BG)
        tk.Label(page, text=intro, font=F(0.8), bg=BG, fg=DIM, wraplength=w - u * 3,
                 justify="left").pack(anchor="w")
        # Scrollable area for the rows.
        box = tk.Frame(page, bg=BG)
        box.pack(fill="both", expand=True, pady=(u * 0.3, 0))
        canvas = tk.Canvas(box, bg=BG, highlightthickness=0)
        bar = tk.Scrollbar(box, orient="vertical", command=canvas.yview, bg=CARD,
                           troughcolor=BG, activebackground=DIM, highlightthickness=0, bd=0)
        rows_frame = tk.Frame(canvas, bg=BG)
        rows_frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        win = canvas.create_window((0, 0), window=rows_frame, anchor="nw")
        canvas.bind("<Configure>", lambda e: canvas.itemconfigure(win, width=e.width))
        canvas.configure(yscrollcommand=bar.set)
        canvas.pack(side="left", fill="both", expand=True)
        bar.pack(side="right", fill="y")
        scroll_areas.append(canvas)             # mouse-wheel scrolling, see wheel()

        def redraw():
            """Rebuild the rows from lists[name], sorted the way they fire."""
            for child in rows_frame.winfo_children():
                child.destroy()
            rows = lists[name]
            rows.sort(key=lambda r: r["level"].get(), reverse=(name == "battery"))
            if not rows:
                tk.Label(rows_frame, text="No alerts. Use “Add level” to create one.",
                         font=F(0.85), bg=BG, fg=DIM).pack(anchor="w", pady=u * 0.5)
            for r in rows:
                line = tk.Frame(rows_frame, bg=BG)
                line.pack(fill="x", pady=u * 0.15)
                # level dropdown
                level_picker(line, r["level"].get(), lambda n, r=r: pick(r, n)).pack(side="left")
                # remove, test, message
                btn(line, "✕", lambda r=r: remove(r), fg=BAD).pack(side="right", padx=(u * 0.2, 0))
                btn(line, "▶", lambda r=r: play(r["message"].get, r["level"].get),
                    color=ACC, fg="white").pack(side="right", padx=(u * 0.3, 0))
                entry(line, r["message"]).pack(side="left", fill="x", expand=True, padx=(u * 0.4, 0),
                                              ipady=u * 0.2)

        def pick(r, n):
            """A new level chosen in a row's dropdown. Refused if another row
            already uses it; otherwise the list is re-sorted."""
            if n == r["level"].get():
                return True
            if any(o["level"].get() == n for o in lists[name] if o is not r):
                status.config(text=f"{n}% is already in this list.", fg=BAD)
                return False
            r["level"].set(n)
            mark_dirty()
            root.after_idle(redraw)     # re-sort after the dropdown has closed
            return True

        def remove(r):
            """Delete one alert row (the ✕ button)."""
            lists[name].remove(r)
            mark_dirty()
            redraw()

        def add():
            """Add a level at a free spot near where new alerts usually go."""
            taken = {o["level"].get() for o in lists[name]}
            lvl = new_level(taken)
            if lvl is None:
                status.config(text="No free level left between 1% and 99%.", fg=BAD)
                return
            lists[name].append(new_row(lvl, shared_default))
            mark_dirty()
            redraw()

        btn(page, "+ Add level", add, size=0.85, width=11).pack(anchor="w", pady=(u * 0.4, 0))
        page.redraw = redraw
        return page

    def new_row(level, message):
        """Variables for one list row: its level and message."""
        return {"level": tk.IntVar(value=level), "message": tk.StringVar(value=message)}

    def free_below(taken):      # on battery: 10 below the lowest, else 50
        """First free level at or above the suggestion, else below it."""
        start = (min(taken) - 10) if taken else 50
        for lvl in list(range(max(start, 1), 100)) + list(range(max(start, 1) - 1, 0, -1)):
            if lvl not in taken:
                return lvl
        return None

    def free_above(taken):      # charging: 10 above the highest, else 80
        """First free level at or below the suggestion, else above it."""
        start = (max(taken) + 10) if taken else 80
        for lvl in list(range(min(start, 99), 0, -1)) + list(range(min(start, 99) + 1, 100)):
            if lvl not in taken:
                return lvl
        return None

    # Mouse-wheel scrolling for the level lists: scroll whichever list the
    # pointer is over (and nothing while the pointer is in a dropdown pop-up).
    scroll_areas = []

    def wheel(e, d):
        """Scroll the level list under the pointer, if any."""
        path = str(e.widget)
        for c in scroll_areas:
            if path.startswith(str(c)):
                c.yview_scroll(d, "units")
                return

    root.bind_all("<Button-4>", lambda e: wheel(e, -1))         # X11 wheel up
    root.bind_all("<Button-5>", lambda e: wheel(e, 1))          # X11 wheel down
    root.bind_all("<MouseWheel>", lambda e: wheel(e, -1 if e.delta > 0 else 1))

    cfg_now = load_config()
    pages = {}
    pages["battery"] = make_list_page(
        "battery",
        "Spoken once each as the battery drops to the level. {p} = percent. "
        "A message left as “" + cfg_now["phrases"]["level"] + "” keeps following the default.",
        cfg_now["phrases"]["level"], free_below)
    pages["charging"] = make_list_page(
        "charging",
        "Spoken once each as the battery charges up to the level. {p} = percent. "
        "Fully charged (100%) is set on the Charger Plugin Status page.",
        cfg_now["phrases"]["charge_level"], free_above)

    # ---- "Low battery" page: countdown start, critical level and their messages
    nums = {"low_below": tk.IntVar(), "critical_at": tk.IntVar()}
    phrase_vars = {k: tk.StringVar() for k in ALERT_PHRASES}
    switch_vars = {k: tk.BooleanVar() for k in CHARGER_SWITCHES}
    for v in list(nums.values()) + list(switch_vars.values()):
        v.trace_add("write", mark_dirty)

    def number_setting(parent, var, label):
        """A caption with a level dropdown (including "Off") bound to `var`.
        Returns a function that refreshes the dropdown after `var` is loaded."""
        line = tk.Frame(parent, bg=BG)
        line.pack(fill="x", pady=(u * 0.5, u * 0.15))
        tk.Label(line, text=label, font=F(0.9, True), bg=BG, fg=FG).pack(side="left", padx=(0, u * 0.5))
        holder = tk.Frame(line, bg=BG)
        holder.pack(side="left")

        def refresh():
            """Rebuild the dropdown so it shows the current value of `var`."""
            for child in holder.winfo_children():
                child.destroy()
            level_picker(holder, var.get(), lambda n: var.set(n), allow_off=True).pack()
        return refresh

    def message_line(parent, key, level_fn, label=None):
        """A message box with a ▶ test button (and an optional caption)."""
        if label:
            tk.Label(parent, text=label, font=F(0.75), bg=BG, fg=DIM).pack(anchor="w", pady=(u * 0.2, 0))
        line = tk.Frame(parent, bg=BG)
        line.pack(fill="x")
        btn(line, "▶", lambda: play(phrase_vars[key].get, level_fn),
            color=ACC, fg="white").pack(side="right", padx=(u * 0.3, 0))
        entry(line, phrase_vars[key]).pack(side="left", fill="x", expand=True, ipady=u * 0.2)

    low = tk.Frame(page_area, bg=BG)
    tk.Label(low, text="Below the countdown level every 1% drop is spoken. {p} = percent.",
             font=F(0.8), bg=BG, fg=DIM, wraplength=w - u * 3, justify="left").pack(anchor="w")
    upd_low = number_setting(low, nums["low_below"], "Count down every 1% below")
    message_line(low, "low", lambda: max(1, nums["low_below"].get() - 1), "Countdown message")
    upd_crit = number_setting(low, nums["critical_at"], "“Critical” wording at or below")
    message_line(low, "critical", lambda: max(1, nums["critical_at"].get()), "Critical message")
    pages["low"] = low

    # ---- "Charger" page: on/off switches and messages
    chg = tk.Frame(page_area, bg=BG)
    tk.Label(chg, text="{p} = percent, {eta} = the time-to-full sentence, {t} = the time.",
             font=F(0.8), bg=BG, fg=DIM).pack(anchor="w")

    def switch(parent, key, text):
        """A caption with a large On/Off button (easier to hit in VR than a tick box)."""
        line = tk.Frame(parent, bg=BG)
        line.pack(fill="x", pady=(u * 0.5, u * 0.1))
        b = btn(line, "", lambda: switch_vars[key].set(not switch_vars[key].get()), width=4, size=0.8)
        b.pack(side="left")
        tk.Label(line, text=text, font=F(0.9, True), bg=BG, fg=FG).pack(side="left", padx=u * 0.4)
        def upd(*_):
            """Show the switch as a green On or a grey Off."""
            on = switch_vars[key].get()
            b.config(text="On" if on else "Off", bg=OK if on else CARD, fg="white" if on else DIM)
        switch_vars[key].trace_add("write", upd)

    switch(chg, "plug_in", "Announce when plugged in")
    message_line(chg, "plug_in", lambda: 62)
    message_line(chg, "plug_in_eta", lambda: 62, "Time-to-full part ({eta} above)")
    message_line(chg, "plug_in_full", lambda: 100, "If already full when plugged in")
    switch(chg, "unplug", "Announce when unplugged")
    message_line(chg, "unplug", lambda: 98)
    switch(chg, "full", "Announce when fully charged")
    message_line(chg, "full", lambda: 100)
    pages["charger"] = chg

    # ---- load a settings dict into the widgets / read it back out
    def load(m):
        """Put a settings dict (see alert_settings) into every widget."""
        for name in ("battery", "charging"):
            lists[name][:] = [new_row(a["level"], a["message"]) for a in m[name]]
            pages[name].redraw()
        nums["low_below"].set(m["low_below"])
        nums["critical_at"].set(m["critical_at"])
        for k in ALERT_PHRASES:
            phrase_vars[k].set(m["phrases"][k])
        for k in CHARGER_SWITCHES:
            switch_vars[k].set(m["switches"][k])
        upd_low(); upd_crit()

    def collect():
        """Read every widget back into a settings dict for saving."""
        return {
            "battery": [{"level": r["level"].get(), "message": r["message"].get()} for r in lists["battery"]],
            "charging": [{"level": r["level"].get(), "message": r["message"].get()} for r in lists["charging"]],
            "low_below": nums["low_below"].get(),
            "critical_at": nums["critical_at"].get(),
            "phrases": {k: v.get() for k, v in phrase_vars.items()},
            "switches": {k: v.get() for k, v in switch_vars.items()},
        }

    # ---- tabs
    tab_buttons = {}

    def show(name):
        """Switch to a page and highlight its tab."""
        if state["page"]:
            pages[state["page"]].pack_forget()
        pages[name].pack(fill="both", expand=True)
        state["page"] = name
        for n, b in tab_buttons.items():
            b.config(bg=ACC if n == name else CARD, fg="white" if n == name else FG)

    for name, label in (("battery", "On battery"), ("low", "Low battery"),
                        ("charging", "Charging"), ("charger", "Charger Plugin Status")):
        tab_buttons[name] = btn(tabs, label, lambda n=name: show(n), width=len(label) + 1)
        tab_buttons[name].pack(side="left", padx=u * 0.2)

    # ---- bottom bar: Defaults / Close / Save
    def save():
        """Validate and save; problems are shown in the status line instead."""
        errors = save_alert_settings(collect())
        if errors:
            status.config(text="Not saved: " + "; ".join(errors), fg=BAD)
            return
        state["dirty"] = False
        status.config(text="Saved. The announcer uses the new alerts within a few seconds.", fg=OK)
        _speak_async("Alert settings saved.")
        load(alert_settings(load_config()))     # show them as stored (sorted, defaults filled)
        state["dirty"] = False
        status.config(text="Saved. The announcer uses the new alerts within a few seconds.", fg=OK)

    def restore_defaults():
        """Show the factory settings; they're only kept if Save is pressed."""
        load(defaults)
        status.config(text="Defaults loaded. Press Save to keep them.", fg=DIM)

    btn(bottom, "Save", save, color=ACC, fg="white", width=7, size=1.0).pack(side="right", padx=(u * 0.4, 0))
    btn(bottom, "Close", root.destroy, width=7, size=1.0).pack(side="right", padx=(u * 0.4, 0))
    btn(bottom, "Defaults", restore_defaults, width=8, size=0.8, fg=DIM).pack(side="right")

    root.bind("<Escape>", lambda e: root.destroy())
    load(model)
    state["dirty"] = False
    status.config(text="Changes apply when you press Save.", fg=DIM)
    show(os.environ.get("BATTERY_ANNOUNCE_PAGE", "battery"))
    if os.environ.get("BATTERY_ANNOUNCE_SCREENSHOT"):   # for testing: auto-close after N ms
        root.after(int(os.environ.get("BATTERY_ANNOUNCE_SCREENSHOT")), root.destroy)
    root.mainloop()
    return 0


# ---------------------------------------------------------------- entry point

def main(argv):
    """Dispatch the command-line verb (see the docstring at the top)."""
    cmd = argv[1] if len(argv) > 1 else "run"
    if cmd == "run":
        cmd_run()
        return 0
    if cmd == "status":
        return cmd_status()
    if cmd == "calibrate" and len(argv) > 2:
        return cmd_calibrate(argv[2])
    if cmd in ("calibrate-gui", "calibrate") and len(argv) == 2:
        return cmd_calibrate_gui()      # `calibrate` with no number opens the window
    if cmd == "reset-calibration":
        return cmd_reset_calibration()
    if cmd == "say" and len(argv) > 2:
        speak(" ".join(argv[2:]), load_config(), cacheable=False)
        return 0
    if cmd == "test":
        return cmd_test()
    if cmd == "now":
        return cmd_now()
    if cmd in ("on", "off", "toggle"):
        return cmd_set_enabled({"on": True, "off": False, "toggle": None}[cmd])
    if cmd == "alerts-gui":
        return cmd_alerts_gui()
    if cmd == "alerts":
        return cmd_alerts(argv[2:])
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
