           "which isn't available.\n\nIn Desktop Mode, run install.sh again from "
           "Konsole: it installs a private copy. Meanwhile, alerts can be changed with:\n"
           "  python3 ~/.local/bin/battery-announce alerts help")
    for tool in (["zenity", "--info", "--width", "520", "--text", msg], ["kdialog", "--msgbox", msg]):
        if shutil.which(tool[0]):
            subprocess.run(tool)
            return 1
