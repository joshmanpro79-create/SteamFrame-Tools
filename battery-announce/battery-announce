# ---------------------------------------------------------------- config

def deep_merge(base, over):
    """Return `base` updated with `over`, merging nested dicts (e.g. "phrases")
    so a config file can change one phrase without repeating the others."""
    out = dict(base)
    for k, v in (over or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def load_config():
    """Load config.json merged over DEFAULTS. A missing or broken file never
    stops the program; it just runs with the defaults."""
    try:
        with open(CONFIG_PATH) as f:
            raw = json.load(f)
        # Older versions stored plain levels as "discharge_thresholds".
        if "discharge_thresholds" in raw and "discharge_alerts" not in raw:
            raw["discharge_alerts"] = [{"level": l, "message": ""} for l in raw["discharge_thresholds"]]
        return deep_merge(DEFAULTS, raw)
    except FileNotFoundError:
        return deep_merge(DEFAULTS, {})
    except Exception as e:
        log(f"config error ({e}); using defaults")
        return deep_merge(DEFAULTS, {})


def save_config_values(values):
    """Write the given keys into config.json, keeping every other key the user
    set. A value of None removes that key, so its default applies again. Writes to a temp file and renames it, so a crash mid-write can't leave
    a half-written config behind. The running service notices the new file
    (by its modification time) and reloads it."""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    current = {}
    try:
        with open(CONFIG_PATH) as f:
            current = json.load(f)
    except Exception:
        pass
    for k, v in values.items():
        if v is None:
            current.pop(k, None)        # None = remove, so the default applies again
        else:
            current[k] = v
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(current, f, indent=2)
    os.replace(tmp, CONFIG_PATH)


def log(msg):
    """Timestamped line on stdout; under systemd it ends up in the journal."""
    print(time.strftime("%H:%M:%S"), msg, flush=True)


# ---------------------------------------------------------------- battery

def rd(path):
    """Read a sysfs file as stripped text, or None if it doesn't exist."""
    try:
        with open(path) as f:
            return f.read().strip()
    except Exception:
        return None


def rd_num(path):
    """Read a sysfs file as a number, or None if missing or not numeric."""
    v = rd(path)
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def supplies():
    """Yield (folder, type) for each power supply that belongs to the device
    itself, such as the main battery or the charger input."""
    for d in sorted(glob.glob(os.path.join(SYSFS, "*"))):
        # Skip controllers, mice, headsets etc. (scope "Device").
        if (rd(os.path.join(d, "scope")) or "").lower() == "device":
            continue
        yield d, rd(os.path.join(d, "type")) or ""


def find_battery():
    """Folder of the main battery, preferring names like BAT0/BAT1."""
    bats = [d for d, t in supplies() if t == "Battery"]
    bats.sort(key=lambda d: (not os.path.basename(d).upper().startswith("BAT"), d))
    return bats[0] if bats else None


def external_power_online():
    """True/False if a Mains/USB supply reports online, None if none exist."""
    found = False
    for d, t in supplies():
        if t in ("Mains", "USB", "USB_C", "USB_PD", "USB_PD_DRP"):
            v = rd(os.path.join(d, "online"))
            if v is None:
                continue
            found = True
            if v.strip() == "1":
                return True
    return False if found else None


def raw_percents(bat):
    """The battery level as the kernel reports it, before any calibration.

    Returns up to two readings, because they can disagree slightly:
      "capacity"      the kernel's own percentage file
      "charge_ratio"  charge_now / charge_full (or energy_*), computed here
    Calibration later picks whichever one tracks Steam's figure better.
    """
    out = {}
    cap = rd_num(os.path.join(bat, "capacity"))
    if cap is not None:
        out["capacity"] = cap
    for now_n, full_n in (("charge_now", "charge_full"), ("energy_now", "energy_full")):
        now = rd_num(os.path.join(bat, now_n))
        full = rd_num(os.path.join(bat, full_n))
        if now is not None and full:
            out["charge_ratio"] = max(0.0, min(100.0, now / full * 100.0))
            break
    return out


def read_state(cfg):
    """One snapshot of the battery, with the calibration correction applied.

    Returns a dict (or None if no battery is found):
      pct      the corrected whole-number percentage that gets announced
      raw      the uncorrected reading from the chosen source
      status   kernel status text: Charging, Discharging, Full, Not charging...
      plugged  True when a charger is connected
      ttf_min / tte_min  minutes to full / to empty, or None if unknown
    """
    bat = find_battery()
    if not bat:
        return None
    raws = raw_percents(bat)
    # Use the configured source if this battery has it, otherwise whatever exists.
    src = cfg["percent_source"] if cfg["percent_source"] in raws else ("capacity" if "capacity" in raws else next(iter(raws), None))
    if src is None:
        return None
    raw = raws[src]
    status = rd(os.path.join(bat, "status")) or "Unknown"
    # Apply the calibration line, then clamp to 0-100 and round.
    pct = raw * float(cfg["percent_scale"]) + float(cfg["percent_offset"])
    pct = int(round(max(0.0, min(100.0, pct))))
    if status == "Full":
        pct = 100
    # Prefer the charger's own "online" flag; fall back to the battery status
    # on hardware that doesn't expose a separate charger entry.
    ext = external_power_online()
    if ext is None:
        plugged = status in ("Charging", "Full", "Not charging")
    else:
        plugged = ext or status in ("Charging", "Full")
    return {
        "bat": bat, "status": status, "plugged": plugged, "pct": pct,
        "raw": raw, "raws": raws, "source": src,
        "ttf_min": time_to_full_minutes(bat),
        "tte_min": time_to_empty_minutes(bat),
    }


def time_to_full_minutes(bat):
    """Minutes until full: the kernel's own estimate if it gives one, otherwise
    the remaining charge divided by the current charging rate."""
    t = rd_num(os.path.join(bat, "time_to_full_now")) or rd_num(os.path.join(bat, "time_to_full_avg"))
    if t and t > 0:
        return t / 60.0                 # kernel reports seconds
    for now_n, full_n, rate_n in (("charge_now", "charge_full", "current_now"),
                                  ("energy_now", "energy_full", "power_now")):
        now = rd_num(os.path.join(bat, now_n))
        full = rd_num(os.path.join(bat, full_n))
        rate = rd_num(os.path.join(bat, rate_n))
        if now is not None and full and rate:
            rate = abs(rate)            # sign convention differs between drivers
            if rate > 0 and full > now:
                mins = (full - now) / rate * 60.0
                if 0 < mins < 24 * 60:  # ignore nonsense from a near-zero rate
                    return mins
    return None


def time_to_empty_minutes(bat):
    """Minutes until empty, worked out the same way as time_to_full_minutes."""
    t = rd_num(os.path.join(bat, "time_to_empty_now")) or rd_num(os.path.join(bat, "time_to_empty_avg"))
    if t and t > 0:
        return t / 60.0
    for now_n, rate_n in (("charge_now", "current_now"), ("energy_now", "power_now")):
        now = rd_num(os.path.join(bat, now_n))
        rate = rd_num(os.path.join(bat, rate_n))
        if now and rate:
            rate = abs(rate)
            if rate > 0:
                mins = now / rate * 60.0
                if 0 < mins < 48 * 60:
                    return mins
    return None


# The running service records the measured rate of change here, so a one-off
# readout (a separate process) can still estimate time when the kernel can't.
RATE_PATH = os.path.join(CACHE_DIR, "rate.json")


def saved_rate():
    """Percent per minute measured by the running service (+ charging, - draining)."""
    try:
        with open(RATE_PATH) as f:
            d = json.load(f)
        if time.time() - d["at"] < 600:     # only trust it if under 10 minutes old
            return d["rate"], d["plugged"]
    except Exception:
        pass
    return None, None


# ---------------------------------------------------------------- calibration reminders
# Until a calibration has been saved near each reminder level (80/60/40/20 by
# default), the announcer asks for one when the battery drops past that level.
# A calibration clears the reminder closest to the level it was taken at.

def nearest_level(levels, value):
    """Closest reminder level to a calibration reading (ties go to the higher level)."""
    return min(levels, key=lambda l: (abs(l - value), -l)) if levels else None


def calibration_levels_done(cfg):
    """Reminder levels already covered by a calibration.

    Stored in config once known; for setups calibrated before reminders
    existed, each saved calibration point covers its nearest level.
    """
    levels = [int(l) for l in cfg.get("calibration_prompt_levels", [])]
    if "calibration_levels_done" in cfg:
        return sorted({int(l) for l in cfg["calibration_levels_done"] if int(l) in levels}, reverse=True)
    return sorted({nearest_level(levels, p["steam"]) for p in cfg.get("calibration_points", [])
                   if isinstance(p, dict) and "steam" in p and levels}, reverse=True)


def pending_prompt_levels(cfg):
    """Reminder levels still waiting for a calibration, highest first."""
    if not cfg.get("calibration_prompts", True):
        return []
    done = set(calibration_levels_done(cfg))
    return [int(l) for l in sorted(cfg.get("calibration_prompt_levels", []), reverse=True)
            if int(l) not in done]


# ---------------------------------------------------------------- alert levels
# The level alerts can be edited in the Battery Alerts window, so they are read
# through these helpers, which tidy up whatever is in the config file.

def fill(template, **values):
    """Fill {p}, {eta} and {t} placeholders in a message.

    Plain text replacement instead of str.format, so a message typed in the
    settings window can contain any other braces without causing an error.
    """
    out = str(template)
    for k, v in values.items():
        out = out.replace("{" + k + "}", str(v))
    return out


def _alert_list(items, default_message):
    """Normalize a list of alerts to [(level, message)], dropping invalid or
    duplicate levels. Accepts {"level": 40, "message": "..."} or a bare 40."""
    seen, out = set(), []
    for it in items or []:
        if isinstance(it, dict):
            level, msg = it.get("level"), (it.get("message") or "").strip()
        else:
            level, msg = it, ""
        try:
            level = int(level)
        except (TypeError, ValueError):
            continue
        if 1 <= level <= 99 and level not in seen:
            seen.add(level)
            out.append((level, msg or default_message))
    return out


def discharge_alerts(cfg):
    """On-battery alerts as [(level, message)], highest level first."""
    return sorted(_alert_list(cfg.get("discharge_alerts"), cfg["phrases"]["level"]), reverse=True)


def charge_alerts(cfg):
    """Charging alerts as [(level, message)], lowest level first."""
    return sorted(_alert_list(cfg.get("charge_alerts"), cfg["phrases"]["charge_level"]))


# ---------------------------------------------------------------- speech

def find_piper(cfg):
    """Path to the Piper program: the configured one, the copy install.sh
    unpacked, a Python-venv fallback install, or one on the PATH."""
    cands = [cfg.get("piper_bin"),
             os.path.join(DATA_DIR, "piper", "piper"),
             os.path.join(DATA_DIR, "venv", "bin", "piper"),
             shutil.which("piper")]
    for c in cands:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def find_model(cfg):
    """Path to the Piper voice (.onnx file); the first one found unless configured."""
    if cfg.get("voice_model") and os.path.isfile(cfg["voice_model"]):
        return cfg["voice_model"]
    models = sorted(glob.glob(os.path.join(DATA_DIR, "voices", "*.onnx")))
    return models[0] if models else None


def find_player():
    """First available audio player, preferring PipeWire's own tools."""
    for p in ("pw-play", "pw-cat", "paplay", "aplay"):
        path = shutil.which(p)
        if path:
            return p, path
    return None, None


def synth(text, cfg, cacheable):
    """Turn text into a WAV file with Piper and return its path (None on failure).

    Fixed phrases ("Battery 40 percent.") are cached by a hash of the text,
    voice and speed, so after the first time they play instantly. Phrases that
    change every time (with a time estimate) go to a temp file instead.
    """
    piper, model = find_piper(cfg), find_model(cfg)
    if not piper or not model:
        log("Piper or voice model not found; run install.sh again")
        return None
    key = hashlib.sha1(f"{text}|{model}|{cfg['length_scale']}".encode()).hexdigest()[:16]
    if cacheable:
        os.makedirs(CACHE_DIR, exist_ok=True)
        out = os.path.join(CACHE_DIR, key + ".wav")
        if os.path.isfile(out) and os.path.getsize(out) > 44:   # 44 bytes = empty WAV header
            return out
    else:
        fd, out = tempfile.mkstemp(suffix=".wav", prefix="battery-announce-")
        os.close(fd)
    cmd = [piper, "-m", model, "-f", out, "--length_scale", str(cfg["length_scale"])]
    try:
        # Piper reads the text on stdin. It runs from its own folder so it finds
        # the libraries bundled next to it.
        r = subprocess.run(cmd, input=text.encode(), stdout=subprocess.DEVNULL,
                           stderr=subprocess.PIPE, timeout=30,
                           cwd=os.path.dirname(piper))
        if r.returncode != 0:
            # Newer piper builds spell the option differently; retry without it.
            r = subprocess.run(cmd[:5], input=text.encode(), stdout=subprocess.DEVNULL,
                               stderr=subprocess.PIPE, timeout=30, cwd=os.path.dirname(piper))
        if r.returncode != 0 or not os.path.isfile(out):
            log("piper failed: " + r.stderr.decode(errors="replace")[-300:])
            return None
    except Exception as e:
        log(f"piper error: {e}")
        return None
    return out


def play(wav, cfg):
    """Play a WAV file and wait for it to finish, using whichever player exists.
    Each player takes its volume in a different form, hence the branches."""
    name, path = find_player()
    if not path:
        log("no audio player found (pw-play/paplay/aplay)")
        return
    vol = float(cfg.get("volume", 1.0))
    if name in ("pw-play", "pw-cat"):
        cmd = [path] + (["--playback"] if name == "pw-cat" else []) + [f"--volume={vol}", wav]
    elif name == "paplay":
        cmd = [path, f"--volume={int(max(0, min(1.5, vol)) * 65536)}", wav]   # 65536 = 100%
    else:
        cmd = [path, "-q", wav]         # aplay has no volume option
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    except Exception as e:
        log(f"playback error: {e}")


def speak(text, cfg, cacheable=True):
    """Say `text` out loud: synthesize, play, and tidy up any temp file.
    BATTERY_ANNOUNCE_DRYRUN=1 only logs the text (used for testing)."""
    log("say: " + text)
    if os.environ.get("BATTERY_ANNOUNCE_DRYRUN"):
        return
    wav = synth(text, cfg, cacheable)
    if wav:
        play(wav, cfg)
        if not cacheable:
            try:
                os.remove(wav)
            except OSError:
                pass


def fmt_duration(mins):
    """Minutes as speakable text rounded to 5 minutes, e.g. "1 hour 15 minutes".
    Returns None for under 2 minutes, where an estimate isn't worth saying."""
    m = int(round(mins / 5.0)) * 5
    if m < 5:
        return "5 minutes" if mins >= 2 else None
    h, m = divmod(m, 60)
    parts = []
    if h:
        parts.append(f"{h} hour" + ("s" if h != 1 else ""))
    if m:
        parts.append(f"{m} minutes")
    return " ".join(parts)


# ---------------------------------------------------------------- logic

class Announcer:
    """Decides when to speak. The service calls tick() every few seconds with a
    fresh battery snapshot; the announcer compares it with what it has seen and
    said so far.

    Rules:
      - on battery: level alerts (40/30/20 by default) once each, then every 1% below 15
      - while charging: charging level alerts (none by default) once each
      - calibration reminders at their levels while still pending
      - charger plugged in: "Charging, NN percent, about T to full"
      - charger removed: "On battery, NN percent"
      - reaches 100% while charging: "Fully charged"
    Every level is spoken once per discharge, so a reading that wobbles up and
    down doesn't repeat itself.
    """

    def __init__(self, cfg):
        """Start with no history: the first tick() just learns the current state."""
        self.cfg = cfg
        self.ph = cfg["phrases"]
        self.plugged = None          # last confirmed plug state
        self.candidate = None        # plug state seen once, awaiting confirmation
        self.done_thresholds = set() # discharge alert levels already spoken this discharge
        self.done_charge = set()     # charging alert levels already spoken this charge
        self.last_pct = None         # latest announced %, used when settings change
        self.done_prompts = set()    # calibration reminders already given this discharge
        self.last_low = None         # lowest % spoken in the every-1% zone
        self.full_spoken = False     # "Fully charged" already said this charge
        self.pending_plug_at = None  # when to speak the delayed plug-in message
        self.last_tick = time.monotonic()
        self.samples = []            # (monotonic, raw %, plugged) for rate estimates
        self.rate_written = 0        # when RATE_PATH was last updated

    def say(self, text, cacheable=True):
        """Speak unless announcements are muted (muted messages are only logged)."""
        if self.cfg.get("enabled", True):
            speak(text, self.cfg, cacheable)
        else:
            log("muted: " + text)

    def track_rate(self, st, now):
        """Keep 15 minutes of readings and, once a minute, save the measured
        percent-per-minute to RATE_PATH for the manual readout to use."""
        if self.samples and self.samples[-1][2] != st["plugged"]:
            self.samples = []        # plug state changed: old rate no longer applies
        self.samples.append((now, st["raw"], st["plugged"]))
        self.samples = [x for x in self.samples if now - x[0] <= 900]
        if now - self.rate_written >= 60 and len(self.samples) >= 2:
            dt = (self.samples[-1][0] - self.samples[0][0]) / 60.0
            if dt >= 3:              # need at least 3 minutes of data
                rate = (self.samples[-1][1] - self.samples[0][1]) / dt
                try:
                    os.makedirs(CACHE_DIR, exist_ok=True)
                    with open(RATE_PATH, "w") as f:
                        json.dump({"at": time.time(), "rate": rate, "plugged": st["plugged"]}, f)
                    self.rate_written = now
                except OSError:
                    pass

    def level_phrase(self, p):
        """Wording for a level announcement: normal, low or critical."""
        if p <= int(self.ph["critical_at_or_below"]):
            return fill(self.ph["critical"], p=p)
        if p < int(self.cfg["every_percent_below"]):
            return fill(self.ph["low"], p=p)
        return fill(self.ph["level"], p=p)

    def reset_discharge(self, pct):
        """Start a new discharge at `pct`. Thresholds and reminders at or above
        the current level count as already passed, so unplugging at 55% doesn't
        immediately announce 80% or 60%."""
        self.done_thresholds = {l for l, _ in discharge_alerts(self.cfg) if l >= pct}
        self.done_prompts = {l for l in self.cfg["calibration_prompt_levels"] if l >= pct}
        self.last_low = pct if pct < int(self.cfg["every_percent_below"]) else None

    def reset_charge(self, pct):
        """Start a new charge at `pct`: charging alerts at or below the current
        level count as already passed."""
        self.done_charge = {l for l, _ in charge_alerts(self.cfg) if l <= pct}

    def settings_changed(self, old_cfg):
        """Called after config.json is reloaded. Alert levels that are new and
        already behind us are marked as passed, so adding a 50% alert while at
        45% doesn't fire it straight away."""
        if self.last_pct is None:
            return
        pct = self.last_pct
        old_d = {l for l, _ in discharge_alerts(old_cfg)}
        old_c = {l for l, _ in charge_alerts(old_cfg)}
        self.done_thresholds |= {l for l, _ in discharge_alerts(self.cfg) if l not in old_d and l >= pct}
        self.done_charge |= {l for l, _ in charge_alerts(self.cfg) if l not in old_c and l <= pct}

    def tick(self, st):
        """Handle one battery snapshot (see read_state) and speak if needed."""
        now = time.monotonic()
        resumed = now - self.last_tick > 60   # woke from sleep
        self.last_tick = now
        if resumed:
            self.samples = []
        self.track_rate(st, now)
        pct, plugged = st["pct"], st["plugged"]
        self.last_pct = pct

        # First snapshot after start-up: just learn the state. Stay quiet unless
        # the battery is already in the low zone, which is worth hearing at boot.
        if self.plugged is None:
            self.plugged = plugged
            if plugged:
                self.full_spoken = pct >= 100
                self.reset_charge(pct)
            else:
                self.reset_discharge(pct)
                if pct < int(self.cfg["every_percent_below"]):
                    self.say(self.level_phrase(pct))
            return

        # Debounce: a plug change must be seen on two polls in a row.
        # (After waking from sleep a single reading is trusted straight away.)
        if plugged != self.plugged:
            if self.candidate is plugged or resumed:
                self.candidate = None
                self.plugged = plugged
                self.on_plug_change(st)
            else:
                self.candidate = plugged
            return
        self.candidate = None

        if plugged:
            # Delayed plug-in message, then "Fully charged" once at 100%.
            if self.pending_plug_at and now >= self.pending_plug_at:
                self.pending_plug_at = None
                self.announce_plug_in(st)
            elif (self.cfg["announce_full"] and not self.full_spoken and not self.pending_plug_at
                  and (pct >= 100 or st["status"] == "Full")):
                self.full_spoken = True
                self.say(self.ph["full"])
            elif not self.pending_plug_at:
                self.check_charging(pct)
            return

        self.check_discharge(pct)

    def on_plug_change(self, st):
        """A confirmed plug-in or unplug."""
        pct = st["pct"]
        if st["plugged"]:
            # Charging: clear the discharge memory so the next discharge starts fresh.
            self.done_thresholds = set()
            self.done_prompts = set()
            self.last_low = None
            self.full_spoken = False
            self.reset_charge(pct)
            if self.cfg["announce_plug_in"]:
                # Speak a few seconds later, once the charge rate (and so the
                # time-to-full estimate) has settled.
                self.pending_plug_at = time.monotonic() + float(self.cfg["plug_in_delay_seconds"])
        else:
            self.pending_plug_at = None
            self.reset_discharge(pct)
            if self.cfg["announce_unplug"]:
                self.say(fill(self.ph["unplug"], p=pct))

    def announce_plug_in(self, st):
        """"Charging, NN percent, about T to full" (or "Fully charged")."""
        pct = st["pct"]
        if pct >= 100 or st["status"] == "Full":
            self.full_spoken = True
            self.say(self.ph["plug_in_full"])
            return
        eta = ""
        if st["ttf_min"]:
            t = fmt_duration(st["ttf_min"])
            if t:
                eta = fill(self.ph["plug_in_eta"], t=t)
        # Not cached: the time estimate makes nearly every one of these unique.
        # strip(): no stray space left when there's no estimate.
        self.say(fill(self.ph["plug_in"], p=pct, eta=eta).strip(), cacheable=False)

    def check_charging(self, pct):
        """While charging: speak each charging alert level once per charge.
        If several are passed at once, only the highest one's message is spoken."""
        msg = None
        for level, m in charge_alerts(self.cfg):
            if level not in self.done_charge and pct >= level:
                self.done_charge.add(level)
                msg = m                 # ascending order: ends on the highest passed
        if msg:
            self.say(fill(msg, p=pct))

    def check_discharge(self, pct):
        """On battery: speak level alerts, the every-1% low zone and reminders."""
        speak_now = False
        # Level alerts (40/30/20 by default): once each per discharge. Several
        # can be passed at once after sleep; then the lowest one's message is used.
        alert_msg = None
        for level, m in discharge_alerts(self.cfg):
            if level not in self.done_thresholds and pct <= level:
                self.done_thresholds.add(level)
                alert_msg = m           # descending order: ends on the lowest passed
        # Low zone: each new lowest whole percent below 15 is spoken.
        below = int(self.cfg["every_percent_below"])
        if 0 < pct < below and (self.last_low is None or pct < self.last_low):
            self.last_low = pct
            speak_now = True
        # Calibration reminders still pending, once each per discharge.
        prompt = False
        for l in pending_prompt_levels(self.cfg):
            if l not in self.done_prompts and pct <= l:
                self.done_prompts.add(l)
                prompt = True
        # Exactly one message per tick, in priority order: a calibration
        # reminder (it already says the level), then the level alert's own
        # message, then the low/critical countdown wording.
        if prompt:
            self.say(fill(self.ph["calibrate"], p=pct))
        elif alert_msg:
            self.say(fill(alert_msg, p=pct))
        elif speak_now:
            self.say(self.level_phrase(pct))


