def cmd_alerts_gui():
    """Open the alert settings window (or explain the Konsole commands if no
    Python with tkinter is available)."""
    use_gui_python()
    try:
        import tkinter  # noqa: F401  (only checking that it exists)
        return _alerts_tk()
    except ImportError:
        pass
    except Exception as e:          # no display etc.
        log(f"tkinter window failed ({e})")
