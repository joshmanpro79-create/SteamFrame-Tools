    for k, v in st["raws"].items():
        mark = "  <- used" if k == st["source"] else ""
        print(f"Raw {k:<12} {v:.1f}%{mark}")
    print(f"Correction:     x{cfg['percent_scale']:.3f} {cfg['percent_offset']:+.1f}")
    print(f"Announced as:   {st['pct']}%")
    ttf = st["ttf_min"]
    if st["plugged"]:
        print(f"Time to full:   {fmt_duration(ttf) if ttf else 'unknown'}")
    else:
        tte = st["tte_min"]
        print(f"Time remaining: {fmt_duration(tte) if tte else 'unknown'}")
    print(f"Automatic:      {'on' if cfg.get('enabled', True) else 'OFF (muted)'}")
    pend = pending_prompt_levels(cfg)
    print(f"Cal. reminders: {', '.join(f'{l}%' for l in pend) if pend else 'none pending'}")
    print(f"Readout:        {readout_text(cfg, st)}")
    print(f"Piper:          {find_piper(cfg) or 'NOT FOUND'}")
    print(f"Voice:          {find_model(cfg) or 'NOT FOUND'}")
    print(f"Player:         {find_player()[1] or 'NOT FOUND'}")
    print(f"Window Python:  {GUI_PYTHON if os.access(GUI_PYTHON, os.X_OK) else 'SteamOS system Python'}")
    return 0


def apply_calibration(steam):
    """Compare Steam's % with what we announce; save a correction only if they differ.

    Steps:
      1. Mark the nearest reminder level as done (even if nothing differs).
      2. If Steam and the announcer already agree, stop there.
      3. Otherwise store this reading as a calibration point, then pick the raw
         source and the scale/offset line that best match all saved points.

    Returns a dict describing what happened (used by the CLI and the window).
    """
    steam = float(steam)
    if not 0 <= steam <= 100:
        raise ValueError("Steam's percentage must be between 0 and 100")
    cfg = load_config()
    bat = find_battery()
    raws = raw_percents(bat) if bat else {}
    st = read_state(cfg)
    if not raws or not st:
        raise RuntimeError("No battery reading found")
    res = {"steam": steam, "raws": raws, "before": st["pct"], "after": st["pct"],
           "changed": False, "source": cfg["percent_source"],
           "scale": float(cfg["percent_scale"]), "offset": float(cfg["percent_offset"]),
           "points": len(cfg.get("calibration_points", []))}

    # 1. Reminders: this calibration covers the nearest level.
    levels = [int(l) for l in cfg.get("calibration_prompt_levels", [])]
    done_before = calibration_levels_done(cfg)
    level = nearest_level(levels, steam)
    res["cleared"] = level if level is not None and level not in done_before else None
    done_now = sorted(set(done_before) | ({level} if level is not None else set()), reverse=True)
    # Save when something was cleared, or the first time, to store the list
    # (older configs only had calibration points to derive it from).
    if "calibration_levels_done" not in cfg or res["cleared"] is not None:
        save_config_values({"calibration_levels_done": done_now})
        cfg = load_config()
    res["pending"] = pending_prompt_levels(cfg)

    # 2. Already matching: confirmation only, no correction needed.
    if int(round(steam)) == st["pct"]:
        return res

    # 3. New calibration point, recording every raw source so the fit can compare them.
    new_pt = {"steam": steam, **{k: round(v, 2) for k, v in raws.items()}}
    # Replace older points taken at nearly the same level, keep the rest.
    points = [p for p in cfg.get("calibration_points", []) if isinstance(p, dict)
              and not any(k in p and abs(p[k] - v) < 3 for k, v in raws.items())]
    points.append(new_pt)
    points = points[-6:]                # keep the six most recent
    # Try each raw source and keep the one whose fitted line has the lowest
    # average error (a tiny penalty on large offsets breaks near-ties).
    best, best_err, best_fit = None, None, None
    for src in raws:
        pts = [(p[src], p["steam"]) for p in points if src in p]
        fit = fit_line(pts)
        err = sum(abs(x * fit[0] + fit[1] - y) for x, y in pts) / len(pts) + abs(fit[1]) * 0.01
        if best_err is None or err < best_err:
            best, best_err, best_fit = src, err, fit
    scale, offset = best_fit
    save_config_values({"percent_source": best, "percent_scale": round(scale, 4),
                        "percent_offset": round(offset, 2), "calibration_points": points})
    after = read_state(load_config())
    res.update(changed=True, source=best, scale=scale, offset=offset,
               points=len(points), after=after["pct"] if after else int(round(steam)))
    return res


def cmd_calibrate(arg):
    """`calibrate 87`: the command-line version of the calibration window."""
    try:
        res = apply_calibration(arg.rstrip("%"))
    except ValueError:
        print("Usage: battery-announce calibrate 87   (the % Steam shows right now, 0-100)")
        return 1
    except RuntimeError as e:
        print(e)
        return 1
    print("Readings now: " + ", ".join(f"{k} {v:.1f}%" for k, v in res["raws"].items())
          + f"; announced {res['before']}%; Steam {res['steam']:g}%")
    if res.get("cleared") is not None:
        print(f"Calibration reminder for {res['cleared']}% cleared.")
    print("Reminders still pending: " + (", ".join(f"{l}%" for l in res["pending"]) or "none"))
    if not res["changed"]:
        print("Already matches Steam; correction unchanged.")
        return 0
    print(f"Saved: source={res['source']}, scale={res['scale']:.3f}, offset={res['offset']:+.2f} "
          f"({res['points']} calibration point{'s' if res['points'] != 1 else ''}). "
          f"Now announces {res['after']}%.")
    if res["points"] < 2:
        print("Tip: calibrate again later at a level at least 20 points away for a better fit.")
    print("The running service picks this up within a few seconds.")
    return 0


def fit_line(pts):
    """Fit Steam % = raw % * scale + offset through (raw, steam) points.

    Offset only for one point (or close points); least squares otherwise.
    Returns (scale, offset).
    """
    xs = [x for x, _ in pts]
    if len(pts) < 2 or max(xs) - min(xs) < 15:
        # Points too close together to judge a slope: just shift by the average gap.
        off = sum(y - x for x, y in pts) / len(pts)
        return 1.0, off
    # Ordinary least-squares straight line.
    n = len(pts)
    mx, my = sum(xs) / n, sum(y for _, y in pts) / n
    sxx = sum((x - mx) ** 2 for x in xs)
    sxy = sum((x - mx) * (y - my) for x, y in pts)
    scale = sxy / sxx
    if not 0.8 <= scale <= 1.25:          # implausible, fall back to offset only
        return 1.0, my - mx
    return scale, my - scale * mx


def cmd_reset_calibration():
    """Forget all calibration; reminders return and the raw value is announced."""
    save_config_values({"percent_source": "capacity", "percent_scale": 1.0,
                        "percent_offset": 0.0, "calibration_points": [],
                        "calibration_levels_done": []})
    print("Calibration removed; announcing the raw kernel value. Calibration reminders are back on.")
    return 0


def cmd_test():
    """Speak one example of each announcement, to check the voice and volume."""
    cfg = load_config()
    ph = cfg["phrases"]
    first = discharge_alerts(cfg)[:1]
    level_text = fill(first[0][1], p=first[0][0]) if first else fill(ph["level"], p=40)
    for text in (level_text, fill(ph["low"], p=14), fill(ph["critical"], p=3),
                 fill(ph["plug_in"], p=62, eta=fill(ph["plug_in_eta"], t="45 minutes")),
                 fill(ph["unplug"], p=98), ph["full"]):
        speak(text, cfg, cacheable=False)
        time.sleep(0.4)
    return 0


def readout_text(cfg, st):
    """Text for the manual readout, e.g. "Discharging. 54 percent. Estimated
    2 hours remaining." Uses the kernel's time estimate, or failing that the
    rate the running service measured (see saved_rate)."""
    ph, pct = cfg["phrases"], st["pct"]
    rate, rate_plugged = saved_rate()
    if st["plugged"]:
        if pct >= 100 or st["status"] == "Full":
            return ph["readout_full"]
        mins = st["ttf_min"]
        if mins is None and rate and rate > 0.05 and rate_plugged:
            mins = (100 - pct) / rate
        if st["status"] == "Not charging" and not mins:
            return fill(ph["readout_plugged_idle"], p=pct)
        t = fmt_duration(mins) if mins else None
        return fill(ph["readout_charging"], p=pct, eta=fill(ph["readout_eta_full"], t=t) if t else "")
    mins = st["tte_min"]
    if mins is None and rate and rate < -0.02 and rate_plugged is False:
        mins = pct / -rate
    t = fmt_duration(mins) if mins else None
    return fill(ph["readout_discharging"], p=pct, eta=fill(ph["readout_eta_empty"], t=t) if t else "")


def cmd_now():
    """`now`: speak the readout once (the Battery Readout launcher)."""
    cfg = load_config()
    st = read_state(cfg)
    if not st:
        print("No battery found.")
        return 1
    speak(readout_text(cfg, st), cfg, cacheable=False)   # works even when muted
    return 0


def cmd_set_enabled(value):
    """`on` / `off` / `toggle` (value None): mute or unmute the automatic
    announcements and say the new state. The running service reloads the
    config file within a few seconds."""
    cfg = load_config()
    if value is None:
        value = not cfg.get("enabled", True)
    save_config_values({"enabled": value})
    cfg["enabled"] = value
    speak(cfg["phrases"]["unmuted" if value else "muted"], cfg)
    print("Automatic announcements", "ON" if value else "OFF")
    return 0


# ---------------------------------------------------------------- calibration window
# Launched from Steam as "Battery Calibrate". Tries, in order: a tkinter window
# (large buttons, readable in VR), a zenity slider, a kdialog input box, and
# finally a terminal prompt, because not every SteamOS build includes tkinter.

def _speak_async(text):
    """Speak without blocking the window (uses this same script's `say`)."""
    if os.environ.get("BATTERY_ANNOUNCE_DRYRUN"):
        log("say: " + text)
        return
    try:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "say", text],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except Exception:
        pass


def _reminder_text(res):
    """Sentence about reminders after a save, e.g. "The 60% reminder is cleared.
    Reminders left: 80%, 40%, 20%." """
    cleared = (f"The {res['cleared']}% reminder is cleared. "
               if res.get("cleared") is not None else "")
    pend = res.get("pending") or []
    left = ("Reminders left: " + ", ".join(f"{l}%" for l in pend) + "."
            if pend else "All calibration reminders are done.")
    return cleared + left


def _result_lines(res):
    """(title, body) shown after saving, for every dialog style."""
    if not res["changed"]:
        return ("Already matches Steam",
                f"Steam and the announcer both read {res['before']}%. No correction needed. "
                + _reminder_text(res))
    return ("Calibration saved",
            f"Announcer changed from {res['before']}% to {res['after']}% "
            f"(sensor x{res['scale']:.3f} {res['offset']:+.1f}). " + _reminder_text(res))


def _snapshot():
    """What the window displays: raw and announced %, plug state, reminders."""
    cfg = load_config()
    st = read_state(cfg)
    if not st:
        return None
    return {"raw": st["raw"], "pct": st["pct"], "status": st["status"],
            "plugged": st["plugged"], "source": st["source"],
            "calibrated": bool(cfg.get("calibration_points")),
            "pending": pending_prompt_levels(cfg)}


def use_gui_python():
    """Restart this command under the private window Python if install.sh
    created one (it only does so when SteamOS's Python can't draw windows).
    Does nothing if it's missing or already running."""
    if not os.path.isfile(GUI_PYTHON) or not os.access(GUI_PYTHON, os.X_OK):
        return
    if os.path.realpath(sys.executable) == os.path.realpath(GUI_PYTHON):
        return
    try:
        os.execv(GUI_PYTHON, [GUI_PYTHON, os.path.abspath(__file__)] + sys.argv[1:])
    except OSError as e:
        log(f"couldn't start the window Python ({e}); using this one")


def cmd_calibrate_gui():
    """Open the calibration window, falling back to simpler dialogs."""
    use_gui_python()
    snap = _snapshot()
    if not snap:
        msg = "No battery reading found."
        print(msg)
        for tool in (["zenity", "--error", "--text", msg], ["kdialog", "--error", msg]):
            if shutil.which(tool[0]):
                subprocess.run(tool)
                break
        return 1
    try:
        import tkinter  # noqa: F401  (only checking that it exists)
        return _calibrate_tk(snap)
    except ImportError:
        pass
    except Exception as e:          # no display etc.
        log(f"tkinter window failed ({e}); trying another dialog")
    if shutil.which("zenity"):
        return _calibrate_zenity(snap)
    if shutil.which("kdialog"):
        return _calibrate_kdialog(snap)
    return _calibrate_terminal(snap)


def _describe(snap):
    """One-line summary used by the simple dialogs."""
    state = "Charging" if snap["plugged"] else "On battery"
    return (f"Battery sensor reads {snap['raw']:.0f}%. "
            f"The announcer says {snap['pct']}% ({state}).")


def _finish(res):
    """Common end of every dialog: print the result and say it out loud."""
    title, body = _result_lines(res)
    print(title + ". " + body)
    _speak_async("Calibration saved. " + f"{res['after']} percent." if res["changed"]
                 else f"Already matches Steam. {res['before']} percent.")
    return title, body


def _calibrate_zenity(snap):
    """Fallback 1: zenity slider preset to the announcer's value."""
    r = subprocess.run(["zenity", "--scale", "--title", "Battery Calibration",
                        "--text", _describe(snap) + "\n\nSet the slider to the percentage Steam shows:",
                        "--min-value", "0", "--max-value", "100",
                        "--value", str(snap["pct"]), "--step", "1", "--width", "560"],
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        return 0                        # cancelled
    try:
        title, body = _finish(apply_calibration(r.stdout.strip()))
    except Exception as e:
        subprocess.run(["zenity", "--error", "--text", str(e)])
        return 1
    subprocess.run(["zenity", "--info", "--title", title, "--text", body, "--width", "480"])
    return 0


def _calibrate_kdialog(snap):
    """Fallback 2: KDE input box preset to the announcer's value."""
    r = subprocess.run(["kdialog", "--title", "Battery Calibration", "--inputbox",
                        _describe(snap) + "\n\nWhat percentage does Steam show?", str(snap["pct"])],
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        return 0                        # cancelled
    try:
        title, body = _finish(apply_calibration(r.stdout.strip().rstrip("%")))
    except Exception as e:
        subprocess.run(["kdialog", "--error", f"Not saved: {e}"])
        return 1
    subprocess.run(["kdialog", "--title", title, "--msgbox", body])
    return 0


def _calibrate_terminal(snap):
    """Last resort: ask in the terminal."""
    print(_describe(snap))
    try:
        v = input(f"What percentage does Steam show? [{snap['pct']}] ").strip() or str(snap["pct"])
        _finish(apply_calibration(v.rstrip("%")))
    except (EOFError, KeyboardInterrupt):
        return 0
    except Exception as e:
        print("Not saved:", e)
        return 1
    return 0


def _calibrate_tk(snap):
    """The main calibration window.

    Layout: two cards (raw sensor % and announced %), the reminders still
    pending, the question "What does Steam show right now?" with -10/-1/+1/+10
    buttons around a big number, then Save / Cancel / Reset. After saving it
    switches to a result screen that closes itself after 10 seconds.
    """
    import tkinter as tk

    # Dark theme colours: background, card, text, dim text, accent, success.
    BG, CARD, FG, DIM, ACC, OK = "#15171c", "#22262e", "#eef1f6", "#9aa3b2", "#3d8bfd", "#2fb36d"
    root = tk.Tk()
    root.title("Battery Calibration")
    root.configure(bg=BG)
    # Size everything from the screen height so it stays readable on any display.
    sw, sh = root.winfo_screenwidth(), root.winfo_screenheight()
    u = max(14, min(sh // 34, 40))            # base font size, scales with screen
    w, h = min(sw, u * 46), min(sh, u * 30)
    root.geometry(f"{w}x{h}+{(sw - w) // 2}+{(sh - h) // 2}")   # centred
    F = lambda m, bold=False: ("DejaVu Sans", int(u * m), "bold" if bold else "normal")

    # Mutable window state:
    #   value    the number the user is setting (starts at the announced %)
    #   touched  True once the user has adjusted it (stops live updates overwriting it)
    #   snap     latest battery snapshot
    #   closing  None while editing; seconds left once the result is shown
    state = {"value": snap["pct"], "touched": False, "snap": snap, "closing": None}

    # Two screens: `main` for editing, `result` after saving.
    main = tk.Frame(root, bg=BG)
    result = tk.Frame(root, bg=BG)
    main.pack(fill="both", expand=True, padx=u, pady=u * 0.6)

    tk.Label(main, text="Battery Calibration", font=F(1.5, True), bg=BG, fg=FG).pack(pady=(0, u * 0.5))

    # --- the two reading cards
    cards = tk.Frame(main, bg=BG)
    cards.pack(fill="x")
    def card(col, caption):
        """A card with a caption, a big number and a small note; returns the
        number and note labels so they can be updated later."""
        f = tk.Frame(cards, bg=CARD, padx=u, pady=u * 0.4)
        f.grid(row=0, column=col, sticky="nsew", padx=u * 0.3)
        cards.columnconfigure(col, weight=1)
        tk.Label(f, text=caption, font=F(0.8), bg=CARD, fg=DIM).pack()
        num = tk.Label(f, font=F(2.2, True), bg=CARD, fg=FG)
        num.pack()
        sub = tk.Label(f, font=F(0.7), bg=CARD, fg=DIM)
        sub.pack()
        return num, sub
    raw_lbl, raw_sub = card(0, "Battery sensor")
    ann_lbl, ann_sub = card(1, "Announcer says")

    # --- reminders still pending
    remind = tk.Label(main, font=F(0.7), bg=BG, fg=DIM)
    remind.pack(pady=(u * 0.3, 0))

    # --- the value to enter
    tk.Label(main, text="What does Steam show right now?", font=F(1.05, True),
             bg=BG, fg=FG).pack(pady=(u * 0.5, u * 0.3))

    row = tk.Frame(main, bg=BG)
    row.pack()
    val_lbl = tk.Label(row, font=F(2.6, True), bg=BG, fg=ACC, width=4)

    def btn(parent, text, cmd, color=CARD, fg=FG, size=1.1, width=4):
        """A large flat button that highlights when it has keyboard focus."""
        b = tk.Button(parent, text=text, command=cmd, font=F(size, True), bg=color, fg=fg,
                      activebackground=ACC, activeforeground="white", relief="flat",
                      bd=0, highlightthickness=2, highlightbackground=BG,
                      highlightcolor=ACC, width=width, cursor="hand2", takefocus=1)
        return b

    def show_value():
        """Redraw the big number and the hint saying what Save will do."""
        val_lbl.config(text=f"{state['value']}%")
        diff = state["value"] - state["snap"]["pct"]
        hint.config(text="Matches the announcer: saving confirms it, no correction" if diff == 0
                    else f"{abs(diff)} point{'s' if abs(diff) != 1 else ''} "
                         f"{'higher' if diff > 0 else 'lower'} than the announcer: will be corrected",
                    fg=DIM if diff == 0 else OK)

    def nudge(d):
        """Change the value by d, kept within 0-100."""
        state["value"] = max(0, min(100, state["value"] + d))
        state["touched"] = True
        show_value()

    # -10 / -1  [value]  +1 / +10
    for i, d in enumerate((-10, -1)):
        btn(row, f"{d:+d}".replace("-", "−"), lambda d=d: nudge(d)).grid(row=0, column=i, padx=u * 0.25)
    val_lbl.grid(row=0, column=2, padx=u * 0.5)
    for i, d in enumerate((1, 10)):
        btn(row, f"+{d}", lambda d=d: nudge(d)).grid(row=0, column=3 + i, padx=u * 0.25)

    hint = tk.Label(main, font=F(0.75), bg=BG, fg=DIM)
    hint.pack(pady=(u * 0.3, 0))

    # --- Save / Cancel / Reset (save and reset are defined further down)
    actions = tk.Frame(main, bg=BG)
    actions.pack(pady=(u * 0.8, 0))
    save_b = btn(actions, "Save", lambda: save(), color=ACC, fg="white", width=8)
    save_b.grid(row=0, column=0, padx=u * 0.4)
    btn(actions, "Cancel", root.destroy, width=8).grid(row=0, column=1, padx=u * 0.4)
    btn(actions, "Reset", lambda: reset(), size=0.8, width=7, fg=DIM).grid(row=0, column=2, padx=u * 0.4)

    tk.Label(main, text="Buttons or arrows adjust · Enter saves · Esc closes",
             font=F(0.65), bg=BG, fg=DIM).pack(side="bottom")

    # --- result screen (hidden until Save)
    res_title = tk.Label(result, font=F(1.6, True), bg=BG, fg=OK)
    res_title.pack(pady=(u * 3, u * 0.6))
    res_body = tk.Label(result, font=F(0.95), bg=BG, fg=FG, wraplength=w - u * 4, justify="center")
    res_body.pack(padx=u * 2)
    done_b = btn(result, "Done", root.destroy, color=ACC, fg="white", width=8)
    done_b.pack(pady=u * 1.2)
    countdown = tk.Label(result, font=F(0.65), bg=BG, fg=DIM)
    countdown.pack()

    def refresh_cards():
        """Update the cards and reminder line from the latest snapshot."""
        sn = state["snap"]
        raw_lbl.config(text=f"{sn['raw']:.0f}%")
        raw_sub.config(text="Charging" if sn["plugged"] else "On battery")
        ann_lbl.config(text=f"{sn['pct']}%")
        ann_sub.config(text="calibrated" if sn["calibrated"] else "not calibrated yet")
        pend = sn.get("pending") or []
        remind.config(text=("Calibration reminders left: " + " · ".join(f"{l}%" for l in pend))
                      if pend else "All calibration reminders done")

    def poll():
        """Re-read the battery every 2 seconds while editing. The entered value
        follows the announcer until the user adjusts it."""
        if state["closing"] is not None:
            return
        sn = _snapshot()
        if sn:
            state["snap"] = sn
            if not state["touched"]:
                state["value"] = sn["pct"]
            refresh_cards()
            show_value()
        root.after(2000, poll)

    def show_result(title, body, color=OK):
        """Switch to the result screen and start the 10-second auto-close."""
        main.pack_forget()
        result.pack(fill="both", expand=True)
        res_title.config(text=title, fg=color)
        res_body.config(text=body)
        done_b.focus_set()
        state["closing"] = 10
        tick()

    def tick():
        """Countdown on the result screen; closes the window at zero."""
        if state["closing"] <= 0:
            root.destroy()
            return
        countdown.config(text=f"Closing in {state['closing']} s")
        state["closing"] -= 1
        root.after(1000, tick)

    def save():
        """Apply the entered value (see apply_calibration) and show the outcome."""
        try:
            res = apply_calibration(state["value"])
        except Exception as e:
            show_result("Not saved", str(e), color="#e5534b")
            return
        title, body = _finish(res)
        show_result(title, body, color=OK if res["changed"] else ACC)

    def reset():
        """Clear all calibration and refresh the display."""
        cmd_reset_calibration()
        state["touched"] = False
        poll_once = _snapshot()
        if poll_once:
            state["snap"] = poll_once
            state["value"] = poll_once["pct"]
        refresh_cards()
        show_value()
        hint.config(text="Calibration cleared: announcer now uses the raw sensor value", fg=DIM)

    # Keyboard: arrows/plus/minus adjust, Enter saves (or closes the result
    # screen), Esc closes. Adjusting is ignored once the result is showing.
    for key, d in (("<Left>", -1), ("<Right>", 1), ("<Down>", -10), ("<Up>", 10),
                   ("<minus>", -1), ("<plus>", 1), ("<KP_Subtract>", -1), ("<KP_Add>", 1)):
        root.bind(key, lambda e, d=d: nudge(d) if state["closing"] is None else None)
    root.bind("<Return>", lambda e: save() if state["closing"] is None else root.destroy())
    root.bind("<KP_Enter>", lambda e: save() if state["closing"] is None else root.destroy())
    root.bind("<Escape>", lambda e: root.destroy())

    refresh_cards()
    show_value()
    save_b.focus_set()
    root.after(2000, poll)
    if os.environ.get("BATTERY_ANNOUNCE_SCREENSHOT"):   # for testing: auto-close after N ms
        root.after(int(os.environ.get("BATTERY_ANNOUNCE_SCREENSHOT")), root.destroy)
    root.mainloop()
    return 0


# ---------------------------------------------------------------- alert settings
# Shared by the Battery Alerts window and the `alerts` command: read every
# editable alert setting into one plain dict, validate an edited copy, and
# save it back to config.json.

# Messages editable on the "Low battery" and "Charger" pages.
ALERT_PHRASES = ("low", "critical", "plug_in", "plug_in_eta", "plug_in_full", "unplug", "full")
# Charger on/off switches: settings-window name -> config key.
CHARGER_SWITCHES = {"plug_in": "announce_plug_in", "unplug": "announce_unplug", "full": "announce_full"}


def alert_settings(cfg):
    """All editable alert settings from a config, with every message filled in
    (blank per-level messages show the shared default wording)."""
    return {
        "battery": [{"level": l, "message": m} for l, m in discharge_alerts(cfg)],
        "charging": [{"level": l, "message": m} for l, m in charge_alerts(cfg)],
        "low_below": int(cfg["every_percent_below"]),
        "critical_at": int(cfg["phrases"]["critical_at_or_below"]),
        "phrases": {k: cfg["phrases"][k] for k in ALERT_PHRASES},
        "switches": {k: bool(cfg[v]) for k, v in CHARGER_SWITCHES.items()},
    }


def default_alert_settings():
    """The factory settings, used by "Defaults" / `alerts reset`."""
    return alert_settings(deep_merge(DEFAULTS, {}))


def validate_alert_settings(model):
    """Return a list of problems (empty if the settings can be saved)."""
    errors = []
    for name, label in (("battery", "On battery"), ("charging", "While charging")):
        levels = []
        for a in model[name]:
            try:
                lvl = int(a["level"])
            except (TypeError, ValueError):
                errors.append(f"{label}: '{a['level']}' is not a number")
                continue
            if not 1 <= lvl <= 99:
                errors.append(f"{label}: {lvl}% must be between 1 and 99")
            levels.append(lvl)
            if len(a["message"]) > 200:
                errors.append(f"{label} {lvl}%: message is too long (200 characters max)")
        dups = sorted({l for l in levels if levels.count(l) > 1})
        if dups:
            errors.append(f"{label}: {', '.join(f'{d}%' for d in dups)} listed more than once")
    for key, label in (("low_below", "Countdown start"), ("critical_at", "Critical level")):
        if not 0 <= int(model[key]) <= 99:
            errors.append(f"{label} must be between 0 and 99")
    for k, v in model["phrases"].items():
        if len(v) > 200:
            errors.append(f"Message '{k}' is too long (200 characters max)")
    return errors


def save_alert_settings(model):
    """Validate and write the settings. Messages left blank, or identical to
    the default wording, are stored as "use the default" so they keep
    following it. Returns the list of problems (empty = saved)."""
    errors = validate_alert_settings(model)
    if errors:
        return errors
    cfg = load_config()

    def alerts_out(items, shared, reverse):
        """Sorted alerts for config.json; a message equal to the shared default
        is stored blank so it keeps following that default."""
        out = []
        for a in sorted(items, key=lambda a: int(a["level"]), reverse=reverse):
            msg = a["message"].strip()
            out.append({"level": int(a["level"]), "message": "" if msg == shared else msg})
        return out

    # Phrase overrides: keep the user's other custom phrases, store ours only
    # where they differ from the defaults.
    try:
        with open(CONFIG_PATH) as f:
            phrases = dict(json.load(f).get("phrases") or {})
    except Exception:
        phrases = {}
    wanted = {k: (model["phrases"][k].strip() or DEFAULTS["phrases"][k]) for k in ALERT_PHRASES}
    wanted["critical_at_or_below"] = int(model["critical_at"])
    for k, v in wanted.items():
        if v == DEFAULTS["phrases"][k]:
            phrases.pop(k, None)
        else:
            phrases[k] = v

    values = {
        "discharge_alerts": alerts_out(model["battery"], cfg["phrases"]["level"], True),
        "charge_alerts": alerts_out(model["charging"], cfg["phrases"]["charge_level"], False),
        "discharge_thresholds": None,   # old name, superseded by discharge_alerts
        "every_percent_below": int(model["low_below"]),
        "phrases": phrases or None,
    }
    for k, key in CHARGER_SWITCHES.items():
        values[key] = bool(model["switches"][k])
    save_config_values(values)
    return []


def _sample_text(msg, level):
    """A message as it would be spoken, for the test buttons."""
    return fill(msg, p=level, t="45 minutes",
                eta=fill(load_config()["phrases"]["plug_in_eta"], t="45 minutes")).strip()


def cmd_alerts(args):
    """`alerts ...`: view and change alerts from Konsole (same settings as the
    Battery Alerts window). Run `battery-announce alerts help` for usage."""
    usage = """Usage:
  battery-announce alerts                              show all alert settings
  battery-announce alerts add battery|charging LEVEL ["MESSAGE"]
  battery-announce alerts remove battery|charging LEVEL
  battery-announce alerts message battery|charging LEVEL "MESSAGE"   ("" = default)
  battery-announce alerts message low|critical|plug_in|plug_in_eta|plug_in_full|unplug|full "MESSAGE"
  battery-announce alerts countdown N        every-1% countdown below N% (0 = off)
  battery-announce alerts critical N         "critical" wording at or below N%
  battery-announce alerts on|off plug_in|unplug|full
  battery-announce alerts reset              restore the default alerts
Placeholders: {p} = percent, {eta} = the time-to-full sentence, {t} = a time."""
    m = alert_settings(load_config())
    try:
        verb = args[0] if args else "show"
        if verb in ("show", "list"):
            pass
        elif verb == "reset":
            m = default_alert_settings()
        elif verb in ("add", "remove") or (verb == "message" and args[1] in ("battery", "charging")):
            which, level = args[1], int(args[2])
            if which not in ("battery", "charging"):
                raise IndexError
            items = [a for a in m[which] if a["level"] != level]
            if verb == "add":
                shared = load_config()["phrases"]["level" if which == "battery" else "charge_level"]
                items.append({"level": level, "message": args[3] if len(args) > 3 else shared})
            elif verb == "remove":
                if len(items) == len(m[which]):
                    print(f"No {which} alert at {level}%.")
                    return 1
            else:   # message for one level
                if len(items) == len(m[which]):
                    print(f"No {which} alert at {level}%; add it first.")
                    return 1
                items.append({"level": level, "message": args[3]})
            m[which] = items
        elif verb == "message":
            key = args[1].replace("-", "_")
            if key not in ALERT_PHRASES:
                raise IndexError
            m["phrases"][key] = args[2]
        elif verb == "countdown":
            m["low_below"] = int(args[1])
        elif verb == "critical":
            m["critical_at"] = int(args[1])
        elif verb in ("on", "off"):
            key = args[1].replace("-", "_")
            if key not in CHARGER_SWITCHES:
                raise IndexError
            m["switches"][key] = verb == "on"
        else:
            print(usage)
            return 1
    except (IndexError, ValueError):
        print(usage)
        return 1
    if verb not in ("show", "list"):
        errors = save_alert_settings(m)
        if errors:
            print("Not saved:\n  " + "\n  ".join(errors))
            return 1
        print("Saved. The running announcer picks this up within a few seconds.\n")
        m = alert_settings(load_config())
    # Show the result.
    print("On battery:")
    for a in m["battery"] or [{"level": "-", "message": "(none)"}]:
        print(f"  {a['level']:>3}%  {a['message']}")
    print(f"  Countdown every 1% below {m['low_below']}%: {m['phrases']['low']}"
          if m["low_below"] else "  Countdown: off")
    print(f"  Critical at or below {m['critical_at']}%: {m['phrases']['critical']}")
    print("While charging:")
    for a in m["charging"] or [{"level": "-", "message": "(none)"}]:
        print(f"  {a['level']:>3}%  {a['message']}")
    print("Charger:")
    for k, label in (("plug_in", "Plugged in"), ("unplug", "Unplugged"), ("full", "Fully charged")):
        state = "on " if m["switches"][k] else "off"
        print(f"  [{state}] {label}: {m['phrases'][k]}")
    print(f"        time-to-full part: {m['phrases']['plug_in_eta']}")
    print(f"        if already full:   {m['phrases']['plug_in_full']}")
    return 0


# ---------------------------------------------------------------- alerts window
# Launched from Steam as "Battery Alerts". Four pages chosen with the tabs at
# the top: On battery, Low battery, Charging, Charger Plugin Status. Nothing is written until
